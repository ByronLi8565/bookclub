{
  "name": "bookclub",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "deploy": "bun run scripts/predeploy-backup.ts && vite build && wrangler deploy",
    "deploy:no-backup": "vite build && wrangler deploy",
    "destroy": "wrangler delete",
    "secrets:sync": "fnox exec -- bash scripts/sync-secrets.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "bun run scripts/test-all.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --config e2e/vitest.config.ts",
    "test:browser": "playwright test",
    "test:perf": "READER_PERF=1 playwright test --project=Performance --workers=1",
    "info:template": "node scripts/new-info-card.mjs",
    "cap:sync": "vite build && cap sync",
    "cap:ios": "vite build && cap sync ios && cap open ios",
    "cap:android": "vite build && cap sync android && cap open android",
    "check": "oxfmt --check && oxlint && bun run typecheck"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@lexical/markdown": "^0.45.0",
    "@lexical/rich-text": "^0.45.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "agents": "^0.16.2",
    "core-js": "^3.49.0",
    "effect": "4.0.0-rc.108",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "foldkit": "0.145.0",
    "lexical": "^0.45.0",
    "pdfjs-dist": "^6.1.200",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@foldkit/vite-plugin": "0.13.1",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/ws": "^8.18.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.54.0",
    "oxlint": "1.78.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0",
    "ws": "^8.22.0"
  },
  "trustedDependencies": [
    "core-js",
    "es5-ext"
  ]
}
